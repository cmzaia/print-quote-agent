# fake = deterministic rule-based provider, no key needed (default for tests/CI)
# anthropic = real model via langchain-anthropic
# auto = anthropic if ANTHROPIC_API_KEY is set, otherwise fake
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: point the engine at a different pricing file
# RATES_PATH=/path/to/rates.yaml
